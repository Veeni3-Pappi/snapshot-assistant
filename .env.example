# AI Configuration - Choose ONE:

# Option 1: Claude AI (More accurate, ~$10/month)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option 2: Gemini AI (Much cheaper, ~$0.25/month - RECOMMENDED!)
# GOOGLE_API_KEY=your_google_api_key_here
# AI_PROVIDER=gemini

# Email Configuration (Resend - Recommended)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_USER=onboarding@resend.dev

# Report Recipient
REPORT_RECIPIENT_EMAIL=recipient@example.com

# SMS Configuration
# Provider options:
# 1. "msms" (Recommended!) - Sends SMS directly through your Android phone using MSMS / smsgt app (Free using your SIM bundle!)
# 2. "africastalking" - Cloud SMS provider (KES ~0.80/SMS)
# 3. "auto" - Tries Android MSMS first; falls back to Africa's Talking if phone is unavailable
SMS_PROVIDER=msms

# Direct Android Phone Gateway URL (Optional, e.g. http://192.168.0.x:8080)
# Not needed if phone uses polling mode or auto-registers with the server
# SMS_GATEWAY_URL=http://192.168.0.108:8080
SMS_SIM_SLOT=0

# SMS Recipient Phone Number
SMS_RECIPIENT=+254700000000

# Africa's Talking SMS (Optional / Fallback)
# Get credentials from: https://africastalking.com/
# Username: "sandbox" for testing, or your username for live
# API Key: Found in your dashboard under API Keys
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_api_key_here
AFRICASTALKING_SENDER_ID=SALON

# Notification Method: email, sms, or both
NOTIFICATION_METHOD=both

# Server Configuration
PORT=3000
