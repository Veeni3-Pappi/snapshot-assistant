# AI Configuration - Choose ONE:

# Option 1: Claude AI (More accurate, ~$10/month)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option 2: Gemini AI (Much cheaper, ~$0.25/month - RECOMMENDED!)
# GOOGLE_API_KEY=your_google_api_key_here
# AI_PROVIDER=gemini

# Email Configuration (Resend - Recommended)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_USER=onboarding@resend.dev

# Report Recipient
REPORT_RECIPIENT_EMAIL=recipient@example.com

# SMS Configuration (Africa's Talking)
# Get credentials from: https://africastalking.com/
# Username: "sandbox" for testing, or your username for live
# API Key: Found in your dashboard under API Keys
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_api_key_here
AFRICASTALKING_SENDER_ID=SALON
SMS_RECIPIENT=+254700000000

# Notification Method: email, sms, or both
NOTIFICATION_METHOD=both

# Server Configuration
PORT=3000
